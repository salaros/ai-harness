# Line endings: LF in the repository and on checkout on every OS, so diffs never show
# ending-only changes. Editors get the same rule from .editorconfig.
* text=auto eol=lf

# TODO.md is a ledger of one-line entries that branches add to at once, so a merge keeps the lines
# both sides added instead of stopping on a conflict. The price: an entry one branch resolved and
# the other edited around comes back, and docs/agents/chain.md's rule of deleting it in the commit
# that resolves it is then a second deletion.
TODO.md merge=union

# Windows batch files need CRLF to run reliably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never normalised or textually diffed.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.7z binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary
