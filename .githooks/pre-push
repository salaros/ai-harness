#!/bin/sh
# .githooks/pre-push
# Before commits leave this machine, refuse an unconfigured clone, then check that what they publish
# is formatted, using the stack's own formatter from scripts/stacks.tsv. Git passes the ref updates
# on stdin. The pre-commit hook already checked each commit's staged files; this is the net under a
# commit made with --no-verify or by a tool that runs no hooks, and the one place a whole-project
# check (a Husky.NET task) runs.
# The decision is scripts/githook.js; this file only finds the repo. Git runs it through
# core.hooksPath, set once per clone by `node scripts/githooks-init.js`.
# To see what it would check: node scripts/githook.js pre-push --dry-run
# To push past a failure: git push --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
exec node "$root/scripts/githook.js" pre-push "$@"
