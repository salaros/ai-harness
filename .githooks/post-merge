#!/bin/sh
# .githooks/post-merge
# After a merge or pull, restore whatever the changed manifests call for (scripts/stacks.tsv).
# The decision is scripts/githook.js, which reads ORIG_HEAD to work out what the merge brought in
# and refuses when there is none; this file only finds the repo. Git runs it through core.hooksPath,
# set once per clone by `node scripts/githooks-init.js`.
# To see what it would restore: node scripts/githook.js post-merge --dry-run
root=$(git rev-parse --show-toplevel) || exit 1
exec node "$root/scripts/githook.js" post-merge "$@"
