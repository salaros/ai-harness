#!/bin/sh
# .githooks/pre-commit
# Before a commit lands, refuse an unconfigured clone, check the shape of the loose-ends ledger,
# then check the documentation chain as the commit will record it. What it checks is the index, not
# the working tree, so what passes is what the commit records.
# The decision is scripts/githook.js; this file only finds the repo. Git runs it through
# core.hooksPath, set once per clone by `node scripts/githooks-init.js`.
# To see what it would check: node scripts/githook.js pre-commit --dry-run
# To commit past a failure: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
exec node "$root/scripts/githook.js" pre-commit "$@"
