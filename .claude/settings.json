{
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node -e \"require(require('child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','inherit']}).trim()+'/.agents/hooks/session-start.js')\"; exit $LASTEXITCODE", "timeout": 20 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node -e \"require(require('child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','inherit']}).trim()+'/.agents/hooks/guard-command.js')\"; exit $LASTEXITCODE", "timeout": 10 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node -e \"require(require('child_process').execFileSync('git',['rev-parse','--show-toplevel'],{encoding:'utf8',stdio:['ignore','pipe','inherit']}).trim()+'/.agents/hooks/check-edit.js')\"; exit $LASTEXITCODE", "timeout": 30 }
        ]
      }
    ]
  }
}
